{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OM Companion",
  "version": "0.1.0",
  "identifier": "ai.om.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OM Companion",
        "width": 1100,
        "height": 760,
        "resizable": true
      }
    ],
    "security": { "csp": null },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
