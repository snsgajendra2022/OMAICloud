OM_AI_DB=artifacts/om_ai.sqlite3
OM_AI_KB=artifacts/knowledge.sqlite3
OM_AI_REGISTRY=artifacts/registry
OM_AI_TENANT=default
OM_AI_ALLOWED_SHELL=echo,pwd,ls
# Production: set keys and require auth
# OM_AI_REQUIRE_AUTH=1
# Format: key or key:role (admin|operator|agent|viewer). Bare key in OM_AI_API_KEYS → operator.
# OM_AI_API_KEYS=devkey:admin,readonly:viewer
# Optional admin-only list (bare key → admin). Paste the key part only into the UI (strip :role).
# OM_AI_API_KEYS_ADMIN=bootstrap-admin:admin
# OM_AI_URL_ALLOWLIST=api.example.com
# OM_AI_CORS_ORIGINS=http://localhost:3000
# OM_AI_RATE_LIMIT=120

# --- Chat backend ---
# Default when unset: om_native (never auto-picks Ollama).
# Force: om_native | ollama | openai | local | auto
#   auto = OpenAI if key set → local OM (Ollama only if OM_AI_CHAT_BACKEND=ollama)
#
# --- OM-1.0 native self-model (recommended default) ---
OM_MODEL_PROVIDER=om_native
OM_AI_CHAT_BACKEND=om_native
OM_MODEL_ID=OM-1.0
OM_MODEL_CONFIG=configs/om-1.0-local.json
OM_MODEL_TOKENIZER=artifacts/tokenizer-fixed-v3.json
OM_MODEL_CHECKPOINT=artifacts/checkpoints/om-1.0-smoke/latest.pt
OM_AI_AUTOLOAD=1
OM_AI_CONFIG=configs/om-1.0-local.json
OM_AI_TOKENIZER=artifacts/tokenizer-fixed-v3.json
OM_AI_CHECKPOINT=artifacts/checkpoints/om-1.0-smoke/latest.pt
# If checkpoint is missing with om_native selected → HTTP 503 "OM-1.0 checkpoint unavailable."
#
# Ollama (explicit opt-in only — not used by default / auto)
# OM_AI_CHAT_BACKEND=ollama
# OM_AI_OLLAMA_URL=http://127.0.0.1:11434
# OM_AI_OLLAMA_MODEL=llama3.2:3b
#
# OpenAI-compatible Chat Completions (cloud or local proxy)
# OM_AI_OPENAI_API_KEY=sk-...
# or OPENAI_API_KEY=sk-...
# OM_AI_OPENAI_BASE_URL=https://api.openai.com/v1
# OM_AI_OPENAI_MODEL=gpt-4o-mini
#
# Local OM checkpoint alias (OM_AI_CHAT_BACKEND=local)
# OM_AI_AUTOLOAD=1
# OM_AI_CONFIG=configs/tiny.json
# OM_AI_TOKENIZER=artifacts/demo/tokenizer.json
# OM_AI_CHECKPOINT=artifacts/demo/om-tiny-dpo.pt
# OM_AI_MODEL_ID=om:free

# --- OM-70B cluster train (Linux CUDA + DeepSpeed; not for Mac completion) ---
# See docs/SERVER_70B_HANDOFF.md. Mac prepares assets; server runs ./scripts/train_70b.sh
# OM_AI_70B_DATA=/data/om/corpus/licensed.jsonl
# OM_AI_70B_TOKENIZER=/data/om/tokenizer-production-65536.json
# OM_AI_70B_CONFIG=configs/70b.json
# OM_AI_70B_DEEPSPEED=configs/deepspeed_zero3.json
# OM_AI_70B_OUTPUT=/data/om/checkpoints/om-70b
#
# After cluster train + consolidate, point serve at the same config/tokenizer/checkpoint:
# OM_AI_CHAT_BACKEND=local
# OM_AI_AUTOLOAD=1
# OM_AI_CONFIG=configs/70b.json
# OM_AI_TOKENIZER=artifacts/tokenizer-production-65536.json
# OM_AI_CHECKPOINT=/data/om/checkpoints/om-70b/<consolidated>.pt
# Local Mac smoke paths (tiny only — NOT 70B):
#   data/production-corpus/clean/fineweb-deduped.jsonl  (~100MB)
#   artifacts/tokenizer-production-65536.json           (HF, vocab 65536)
