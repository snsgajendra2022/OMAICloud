OM_AI_DB=artifacts/om_ai.sqlite3
OM_AI_KB=artifacts/knowledge.sqlite3
OM_AI_TOKENS_DB=artifacts/tokens.sqlite3
OM_AI_ACCOUNTS_DB=artifacts/accounts.sqlite3
OM_AI_REGISTRY=artifacts/registry
OM_AI_TENANT=default
OM_AI_ALLOWED_SHELL=echo,pwd,ls
# Authentication is fail-closed by default when no API keys/database tokens exist.
# Production: configure keys and keep strict auth enabled.
OM_AI_REQUIRE_AUTH=1
# LOCAL DEVELOPMENT ONLY: explicitly enable unauthenticated loopback access if needed.
# Never expose a server with this enabled to a LAN/public network.
# OM_AI_ALLOW_OPEN_DEV_MODE=1
# Format: key or key:role (admin|operator|agent|viewer). Bare key in OM_AI_API_KEYS → operator.
# OM_AI_API_KEYS=devkey:admin,readonly:viewer
# Optional admin-only list (bare key → admin). Paste the key part only into the UI (strip :role).
# OM_AI_API_KEYS_ADMIN=bootstrap-admin:admin
# Account signup (email/password → session token). Set 0 to disable public register.
# OM_AI_ALLOW_REGISTER=1
# OM_AI_AUTH_RATE_LIMIT=20
# OM_AI_SESSION_DAYS=30
# OM_AI_URL_ALLOWLIST=api.example.com
# OM_AI_CORS_ORIGINS=http://localhost:3000
# OM_AI_RATE_LIMIT=0 disables API rate limiting (recommended for local dev).
# OM_AI_RATE_LIMIT=120

# --- Native OM is the default: use OM-owned architecture, tokenizer and checkpoints ---
# The native checkpoint is currently experimental; native-first does NOT mean GPT-5-level quality.
# Improve and evaluate OM's own weights before promoting a checkpoint to production.
OM_NATIVE_ONLY=1
OM_MODEL_PROVIDER=om_native
OM_AI_CHAT_BACKEND=om_native
OM_NATIVE_MODEL_FIRST=1
# Capability router generates substantive answers with OM's own checkpoint by default.
OM_CAPABILITY_NATIVE_GENERATION=1
OM_CAPABILITY_MAX_NEW_TOKENS=768
OM_MODEL_ID=OM-1.0
OM_MODEL_CONFIG=configs/om-1.0-local.json
OM_MODEL_TOKENIZER=artifacts/tokenizer-production-65536.json
OM_MODEL_CHECKPOINT=artifacts/checkpoints/om-1.0-chat-dpo-v4/latest.pt
OM_AI_AUTOLOAD=1
OM_AI_CONFIG=configs/om-1.0-local.json
OM_AI_TOKENIZER=artifacts/tokenizer-production-65536.json
OM_AI_CHECKPOINT=artifacts/checkpoints/om-1.0-chat-dpo-v4/latest.pt

# Native-only mode ignores stale vLLM / Transformers / OpenAI backend settings.
# To intentionally test a separate adapter, set OM_NATIVE_ONLY=0 in a dedicated dev shell.

# Legacy Ollama client exists only under om_ai/legacy/ollama/ for opt-in scripts.
# It is NOT used by om-ai serve / vLLM. Do not set OLLAMA_* for production.

# --- OM-70B cluster train (Linux CUDA + DeepSpeed; not for Mac completion) ---
# See docs/SERVER_70B_HANDOFF.md. Mac prepares assets; server runs ./scripts/train_70b.sh
# OM_AI_70B_DATA=/data/om/corpus/licensed.jsonl
# OM_AI_70B_TOKENIZER=/data/om/tokenizer-production-65536.json
# OM_AI_70B_CONFIG=configs/70b.json
# OM_AI_70B_DEEPSPEED=configs/deepspeed_zero3.json
# OM_AI_70B_OUTPUT=/data/om/checkpoints/om-70b

# --- Context-aware conversation preparation (before canonical chat generation) ---
# Keeps recent turns and ranks relevant history; set 0 to disable for diagnostics.
OM_CONVERSATION_CONTEXT=1
OM_CONVERSATION_MAX_HISTORY=8
OM_CONVERSATION_MAX_RELEVANT=4
OM_CONVERSATION_SUMMARY_MAX_CHARS=700
